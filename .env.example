# ===== API Keys =====
GOOGLE_PLACES_API_KEY=
OUTSCRAPER_API_KEY=
HUNTER_API_KEY=
# Gemini 2.5 Flash Image (Nano Banana) — paid tier ~$0.039/img
# Sin key la app cae a Unsplash automáticamente.
# Si quieres activar: https://aistudio.google.com/apikey + upgrade a paid
GEMINI_API_KEY=

# Google PageSpeed Insights — gratis, 25k req/día con key, sin tarjeta
# https://developers.google.com/speed/docs/insights/v5/get-started
# Sin key también funciona pero con cuota muy reducida
PAGESPEED_API_KEY=

# ===== Datos de la agencia (para PDF de propuesta) =====
AGENCY_NAME=RAIO Development
AGENCY_PHONE=
AGENCY_EMAIL=
AGENCY_WEBSITE=
YOUR_NAME=Tu Nombre

# ===== Modo desarrollo =====
# Si está en "true", usa datos mock en vez de llamar a APIs reales (útil para probar UI)
USE_MOCK_DATA=true

# Netlify para auto-publicar landings (gratis, https://app.netlify.com)
NETLIFY_API_TOKEN=
